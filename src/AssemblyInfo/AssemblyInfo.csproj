<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SlusserLabs.AssemblyInfo</AssemblyName>
    <RootNamespace>SlusserLabs.AssemblyInfo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SlusserLabs.AssemblyInfo</PackageId>
    <Authors>Jacob Slusser</Authors>
    <Title>SlusserLabs AssemblyInfo</Title>
    <Copyright>SlusserLabs, Jacob Slusser, and/or affiliate. All rights reserved.</Copyright>
    <Description>Generates reflection-free constants for assembly attributes and metadata.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SlusserLabs/AssemblyInfo</PackageProjectUrl>
    <PackageTags>assemblyinfo assembly-metadata assembly-attributes source-generator incremental-generator roslyn reflection-free aot msbuild</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <BuildOutputTargetFolder>analyzers/dotnet/cs</BuildOutputTargetFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5131</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AssemblyInfo.Attributes/AssemblyInfo.Attributes.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)SlusserLabs.AssemblyInfo.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/cs/netstandard2.0" Visible="false" />
    <None Include="$(OutputPath)SlusserLabs.AssemblyInfo.Attributes.dll" Pack="true" PackagePath="ref/netstandard2.0" Visible="true" />
    <None Include="../../assets/package-icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludeAssemblyInfoAttributesSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <Target Name="IncludeAssemblyInfoAttributesSymbols">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="$(OutputPath)SlusserLabs.AssemblyInfo.Attributes.pdb">
        <TargetPath>SlusserLabs.AssemblyInfo.Attributes.pdb</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>

</Project>
